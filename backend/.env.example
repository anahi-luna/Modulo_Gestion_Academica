# ============================================================
# Motor de base de datos
# Opciones:
#   sqlite   -> Desarrollo local (recomendado para Frontend)
#   postgres -> PostgreSQL (Docker / Integración)
# ============================================================

DB_ENGINE=postgres 

# SQLite
SQLITE_PATH=db.sqlite

# ============================================================
# PostgreSQL
# Para usar PostgreSQL:
# 1. Cambiar DB_ENGINE=postgres
# 2. Configurar los datos de conexión.
#
# Desarrollo local:
# POSTGRES_HOST=localhost
# POSTGRES_PASSWORD=<tu_contraseña>
#
# Docker:
# POSTGRES_HOST=postgres
# POSTGRES_PASSWORD=postgres
# ============================================================

POSTGRES_HOST=postgres-inscripcion
POSTGRES_PORT=5432
POSTGRES_DB=gestion_academica  #Nombre de la base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Autenticación (Microservicio Auth)
AUTH_SERVICE_URL=http://backend:5000   #si prueban en local cambian el "auth" por "localhost"
JWT_SECRET_KEY=811ea3c35704a634c6bd13710d919b63b79d76435321431ff7466facf89dcddf

# Redis (Sesiones y permisos)
AUTH_COMMON_REDIS_URL=redis://redis:6379/0     #Lo mismo si prueban en local lo cambian "redis" por "localhost"
AUTH_COMMON_SESSION_TTL=900

# Microservicio de Planes
PLANES_SERVICE_URL=http://planes-backend:5000